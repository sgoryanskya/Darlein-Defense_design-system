.cheat__minor i{display:block;width:100%;height:40px;border-radius:var(--r-8);border:1px solid var(--line-soft)}
.cheat__minor b{font-size:13px;font-weight:500;color:var(--text-strong)}
.cheat__fonts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;flex:1}
.cheat__fonts>div{display:flex;flex-direction:column;gap:6px}
.cheat__aa{font-size:72px;line-height:.95;font-weight:600;letter-spacing:-.05em;color:var(--text-strong)}
.cheat__aa--t{font-family:var(--font-tech);font-weight:400;letter-spacing:0}
.cheat__fonts b{font-size:16px;font-weight:600;color:var(--text-strong)}
.cheat__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.cheat__grid button{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:12px 14px;border-radius:var(--r-12);background:var(--surface-2);text-align:left;transition:background var(--t-fast)}
.cheat__grid button:hover{background:var(--surface-3)}
.cheat__grid b{font-size:32px;line-height:1;font-weight:500;letter-spacing:-.04em;color:var(--text-strong);font-variant-numeric:tabular-nums}
.cheat__grid span{font-size:12px;color:var(--text-2);line-height:1.3}
@media (max-width:1180px){.cheat__logo,.cheat__colors,.cheat__type,.cheat__nums{grid-column:span 12}}
@media (max-width:639px){.cheat__anchors{grid-template-columns:1fr 1fr 1fr}.cheat__minor{grid-template-columns:repeat(3,minmax(0,1fr))}.cheat__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cheat__fonts{grid-template-columns:1fr 1fr}.cheat__aa{font-size:56px}}

/* ---------- Мини-визуалы принципов ---------- */
.pv{display:flex;align-items:center;gap:12px;height:56px}
.pv-aa{font-size:40px;line-height:1;font-weight:600;letter-spacing:-.05em;color:var(--text-strong)}
