/* ---------- Типовые раскладки ---------- */
.lays{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.lay{display:flex;flex-direction:column;gap:12px;padding:16px;border-radius:var(--r-20);background:var(--surface);min-width:0}
