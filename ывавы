/* ==========================================================================
   v0.2 · наглядные блоки: шпаргалка, схемы с размерами, до и после
   ========================================================================== */

/* ---------- Шпаргалка ---------- */
.cheat{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:8px}
