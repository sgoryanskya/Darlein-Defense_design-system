.cheat__logobox .logo{height:64px;width:auto}
.cheat__anchors{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.cheat__sw{display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start;gap:4px;min-height:112px;padding:14px 16px;border-radius:var(--r-12);text-align:left;transition:transform var(--t-fast)}
