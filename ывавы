/* ---------- Карта ролей цвета ---------- */
.rm{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:24px 32px;align-items:start}
.rm-mock{position:relative;padding:40px 28px 28px;border-radius:var(--r-20);background:var(--bg);border:1px solid var(--line-soft)}
.rm-mock>.mk{position:absolute;top:12px;left:12px}
