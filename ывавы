/* ---------- Шпаргалка контраста ---------- */
.cxs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.cxs__i{display:flex;flex-direction:column;gap:12px;padding:16px;border-radius:var(--r-20);background:var(--surface)}
.cxs__s{display:flex;align-items:center;justify-content:center;height:72px;border-radius:var(--r-12);font-size:28px;font-weight:600;letter-spacing:-.03em;border:1px solid var(--line-soft)}
