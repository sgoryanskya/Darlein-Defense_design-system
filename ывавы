@media (max-width:639px){.starts{grid-template-columns:1fr}.chiplinks a{height:var(--touch)}}

/* ---------- Схемы с размерами (SVG) ---------- */
.rl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
.rl{display:block;width:100%;min-width:640px;height:auto}
.rl--slide{min-width:560px}
.rl .o{fill:var(--surface-field);stroke:var(--line);stroke-width:1}
