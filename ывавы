  color-scheme:dark;
  color:var(--text);
  background-color:var(--bg);
}
[data-surface=&quot;light&quot;]{
  --bg:var(--c-paper);
  --surface:var(--c-white); --surface-2:var(--c-paper2); --surface-3:var(--c-lhover);
