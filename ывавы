/* ==========================================================================
   Darlein Defense · Дизайн-система v0.7 · 23.09.2026
   Источники по приоритету: брендбук DARLEIN BASE v1.0 → утвержденные макеты
   сайта → прототип сайта (vseleznev54.github.io/ddsite). Цвета названы по роли.
   ========================================================================== */

/* ---------- 0. Константы бренда (не менять) ---------- */
:root{
  --c-white:#FFFFFF;        /* White Base   */
  --c-paper:#EFF2F2;        /* Paper        */
  --c-line-light:#ADB9BE;   /* Line Light   */
  --c-dark:#090A0C;         /* Dark Base    */
  --c-mute:#3F444B;         /* Mute         */
  --c-signal:#67FFD9;       /* Accent       */
  --c-accent-light:#00A191; /* Accent Light */
  --c-accent-ink:#007170;   /* Accent Ink   */

  /* Служебные тона интерфейса: обслуживают контраст, бренд не расширяют */
  --c-d1:#121417; --c-d2:#181B1F; --c-d3:#20242A;
  --c-dline:#2C3138; --c-dline-soft:#1C2025;
  --c-dtext:#D7DADF; --c-dtext2:#9AA1A8; --c-text3:#6B7279;
  --c-paper2:#E2E7E7; --c-lline-soft:#CED6D8; --c-ltext2:#4A5158; --c-lhover:#F7F9F9;

  /* Статусы интерфейса: не для графики и маркетинга */
  --c-ok-d:#67FFD9; --c-ok-l:#007170;
  --c-err-d:#FF8A7A; --c-err-l:#B3261E;
  --c-warn-d:#FFC96B; --c-warn-l:#8A5A00;

  /* Акцент бренда: единственное, что меняет суббренд */
  --brand-signal:var(--c-signal);
  --brand-deep:var(--c-accent-light);
  --brand-ink:var(--c-accent-ink);

  /* Шрифты: как на сайте */
  --font-sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-tech:"Tektur","Bahnschrift","DIN Alternate",ui-monospace,"SF Mono",Menlo,Consolas,monospace;

  /* Шкала отступов: шаг 4 / 8 px */
  --s-4:4px; --s-8:8px; --s-12:12px; --s-16:16px; --s-24:24px; --s-32:32px;
  --s-40:40px; --s-48:48px; --s-64:64px; --s-80:80px; --s-96:96px; --s-128:128px;

  /* Радиусы */
  --r-4:4px; --r-8:8px; --r-12:12px; --r-20:20px; --r-28:28px; --r-pill:999px;

  /* Размеры интерфейса */
  --hdr-h:72px; --field-h:52px; --btn-l:56px; --btn-m:48px; --btn-s:40px; --touch:44px;

  /* Движение */
  --t-fast:160ms cubic-bezier(.2,.6,.2,1);
  --t-slow:420ms cubic-bezier(.2,.6,.2,1);
}

/* Условные акценты суббрендов: только для проверки, цвета не утверждены */
:root[data-accent="a"]{--brand-signal:#7CC4FF;--brand-deep:#2B7FD9;--brand-ink:#0B5CAD}
:root[data-accent="b"]{--brand-signal:#B8A6FF;--brand-deep:#7B61FF;--brand-ink:#5B3FD1}

/* ---------- 1. Роли по поверхности ---------- */
[data-surface="dark"]{
  --bg:var(--c-dark);
  --surface:var(--c-d1); --surface-2:var(--c-d2); --surface-3:var(--c-d3);
  --surface-field:var(--c-d2); --surface-pop:var(--c-d3); --surface-mute:var(--c-mute);
  --line:var(--c-dline); --line-soft:var(--c-dline-soft); --line-strong:var(--c-text3);
  --text-strong:var(--c-white); --text:var(--c-dtext); --text-2:var(--c-dtext2); --text-3:var(--c-text3);
  --accent:var(--brand-signal); --accent-text:var(--brand-signal); --accent-line:var(--brand-signal);
  --accent-fill:var(--brand-signal); --on-accent:var(--c-dark);
  --accent-tint:color-mix(in srgb,var(--brand-signal) 8%,transparent);
  --focus:var(--brand-signal);
  --ok:var(--c-ok-d); --err:var(--c-err-d); --warn:var(--c-warn-d);
  --ok-tint:#1C302E; --err-tint:#2E2223; --warn-tint:#2E2A21;
  --btn-bg:var(--c-white); --btn-fg:var(--c-dark);
  --btn-hover-bg:var(--brand-signal); --btn-hover-fg:var(--c-dark);
  --btn-press-bg:#D7DADF;
  --logo:var(--c-white); --logo-dot:var(--brand-signal);
  --w-h1:600; --w-h2:400; --w-h3:500; --w-num:400;
  --shadow-pop:0 20px 48px rgba(0,0,0,.5);
  --chart-1:var(--brand-signal); --chart-2:var(--c-dtext2); --chart-3:var(--c-mute);
  --shade:rgba(9,10,12,.72);
  --hatch:rgba(255,255,255,.07);
  color-scheme:dark;
  color:var(--text);
  background-color:var(--bg);
}
[data-surface="light"]{
  --bg:var(--c-paper);
  --surface:var(--c-white); --surface-2:var(--c-paper2); --surface-3:var(--c-lhover);
  --surface-field:var(--c-white); --surface-pop:var(--c-white); --surface-mute:var(--c-paper2);
  --line:var(--c-line-light); --line-soft:var(--c-lline-soft); --line-strong:var(--c-text3);
  --text-strong:var(--c-dark); --text:var(--c-dark); --text-2:var(--c-ltext2); --text-3:var(--c-text3);
  --accent:var(--brand-deep); --accent-text:var(--brand-ink); --accent-line:var(--brand-deep);
  --accent-fill:var(--brand-ink); --on-accent:var(--c-white);
  --accent-tint:color-mix(in srgb,var(--brand-deep) 10%,transparent);
  --focus:var(--brand-ink);
  --ok:var(--c-ok-l); --err:var(--c-err-l); --warn:var(--c-warn-l);
  --ok-tint:#E6F1F1; --err-tint:#F8EBEB; --warn-tint:#F3EEE6;
  --btn-bg:var(--c-dark); --btn-fg:var(--c-white);
  --btn-hover-bg:var(--brand-ink); --btn-hover-fg:var(--c-white);
  --btn-press-bg:#2C3138;
  --logo:var(--c-dark); --logo-dot:var(--brand-deep);
  --w-h1:700; --w-h2:500; --w-h3:600; --w-num:500;
  --shadow-pop:0 16px 40px rgba(9,10,12,.14);
  --chart-1:var(--brand-deep); --chart-2:var(--c-ltext2); --chart-3:var(--c-line-light);
  --shade:rgba(239,242,242,.82);
  --hatch:rgba(9,10,12,.07);
  color-scheme:light;
  color:var(--text);
  background-color:var(--bg);
}

/* ---------- 2. Основа ---------- */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:88px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
body{margin:0;font-family:var(--font-sans);font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;font-feature-settings:"calt" 1;background:var(--c-dark);color:var(--c-dtext)}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
h1,h2,h3,h4,h5,p,ul,ol,dl,dd,figure,blockquote{margin:0}
ul,ol{padding:0;list-style:none}
table{border-collapse:collapse}
::selection{background:var(--accent-fill);color:var(--on-accent)}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:var(--r-8)}
[hidden]{display:none!important}
code,kbd{font-family:var(--font-tech);font-size:.86em;letter-spacing:.02em}

/* ---------- 3. Типографика бренда (сайт, 1200+) ---------- */
.dd-display,.dd-h1,.dd-h2,.dd-h3,.dd-h4{color:var(--text-strong);text-wrap:balance;overflow-wrap:break-word;font-family:var(--font-sans)}
.dd-display{font-size:96px;line-height:.95;letter-spacing:-.05em;font-weight:var(--w-h1)}
.dd-h1{font-size:64px;line-height:1;letter-spacing:-.05em;font-weight:var(--w-h1)}
.dd-h2{font-size:48px;line-height:1.05;letter-spacing:-.05em;font-weight:var(--w-h2)}
.dd-h3{font-size:32px;line-height:1.15;letter-spacing:-.02em;font-weight:var(--w-h3)}
.dd-h4{font-size:24px;line-height:1.25;letter-spacing:-.01em;font-weight:var(--w-h3)}
.dd-lead{font-size:22px;line-height:1.4;color:var(--text);font-weight:400;text-wrap:pretty}
.dd-body{font-size:16px;line-height:1.5;color:var(--text);font-weight:400;text-wrap:pretty}
.dd-small{font-size:14px;line-height:1.45;color:var(--text-2)}
.dd-label{font-family:var(--font-tech);font-size:12px;line-height:1.3;letter-spacing:.05em;text-transform:uppercase;font-weight:400;color:var(--text-2)}
.dd-data{font-family:var(--font-tech);font-size:16px;line-height:1.4;letter-spacing:.05em;font-weight:400;color:var(--text);font-variant-numeric:tabular-nums}
.dd-num{font-family:var(--font-sans);font-size:96px;line-height:.9;letter-spacing:-.05em;font-weight:var(--w-num);color:var(--text-strong);font-variant-numeric:tabular-nums}
.dd-upper{text-transform:uppercase}
.dd-muted{color:var(--text-2)}
.dd-accent{color:var(--accent-text)}
.dd-measure{max-width:60ch}
@media (max-width:1199px){.dd-display{font-size:80px}.dd-h1{font-size:56px}.dd-h2{font-size:44px}.dd-h3{font-size:30px}.dd-h4{font-size:22px}.dd-lead{font-size:20px}.dd-num{font-size:80px}}
@media (max-width:979px){.dd-display{font-size:64px}.dd-h1{font-size:48px}.dd-h2{font-size:40px}.dd-h3{font-size:28px}.dd-h4{font-size:20px}.dd-num{font-size:64px}.dd-data{font-size:14px}}
@media (max-width:639px){.dd-display{font-size:48px}.dd-h1{font-size:40px}.dd-h2{font-size:32px}.dd-h3{font-size:24px}.dd-lead{font-size:18px}.dd-num{font-size:56px}}
@media (max-width:479px){.dd-display{font-size:36px}.dd-h1{font-size:32px}.dd-h2{font-size:28px}.dd-h3{font-size:22px}.dd-h4{font-size:18px}.dd-num{font-size:48px}}


/* ==========================================================================
   Оболочка документа (собрана из тех же токенов)
   ========================================================================== */
.ds{display:grid;grid-template-columns:280px minmax(0,1fr);min-height:100vh;background:var(--bg)}
.ds-side{position:sticky;top:0;height:100vh;overflow-y:auto;overscroll-behavior:contain;border-right:1px solid var(--line-soft);padding:24px 16px 40px;display:flex;flex-direction:column;gap:28px;background:var(--bg);scrollbar-width:thin;scrollbar-color:var(--line) transparent}
.ds-brand{display:flex;flex-direction:column;gap:14px;padding:4px 8px 0}
.ds-brand .logo{height:38px;width:auto;color:var(--logo)}
.ds-brand__meta{display:flex;flex-direction:column;gap:4px}
.ds-brand__meta b{font-size:15px;font-weight:600;color:var(--text-strong);letter-spacing:-.01em}
.ds-nav{display:flex;flex-direction:column;gap:22px}
.ds-nav__group{display:flex;flex-direction:column;gap:2px}
.ds-nav__gh{display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:0 10px 6px}
.ds-nav a{display:grid;grid-template-columns:26px minmax(0,1fr) auto;align-items:center;gap:6px;min-height:36px;padding:6px 10px;border-radius:var(--r-8);font-size:14px;font-weight:500;color:var(--text-2);transition:color var(--t-fast),background var(--t-fast)}
.ds-nav a .n{font-family:var(--font-tech);font-size:11px;letter-spacing:.05em;color:var(--text-3)}
.ds-nav a:hover{color:var(--text-strong);background:var(--surface)}
.ds-nav a.is-active{color:var(--text-strong);background:var(--surface)}
.ds-nav a.is-active .n{color:var(--accent-text)}
.ds-legend{display:flex;flex-direction:column;gap:8px;padding:16px 10px 0;border-top:1px solid var(--line-soft)}
.ds-legend span{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--text-2)}

/* Статусные точки: форма, а не цвет */
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;border:1px solid var(--accent);flex:none}
.dot--done{background:var(--accent)}
.dot--draft{background:linear-gradient(90deg,var(--accent) 50%,transparent 50%)}
.dot--frame{background:transparent}
.dot--wait{border-style:dashed;border-color:var(--text-2)}

/* Верхняя панель */
.ds-main{min-width:0}
.ds-top{position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;gap:12px 20px;flex-wrap:wrap;min-height:64px;padding:10px 40px;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line-soft)}
.ds-top__title{display:flex;align-items:center;gap:12px;min-width:0}
.ds-top__title b{font-size:15px;font-weight:600;color:var(--text-strong);white-space:nowrap}
.ds-top__ctrl{display:flex;align-items:center;gap:10px 16px;flex-wrap:wrap}
.ds-ctl{display:flex;align-items:center;gap:8px}
.ds-menu-btn{display:none;width:44px;height:44px;align-items:center;justify-content:center;border-radius:var(--r-pill);color:var(--text-strong);background:var(--surface)}
.ds-menu-btn svg{width:20px;height:20px}

/* Мини-сегменты оболочки */
.ds-seg{display:inline-flex;padding:3px;border-radius:var(--r-pill);background:var(--surface-2);gap:2px}
.ds-seg button{height:32px;padding:0 12px;border-radius:var(--r-pill);font-size:13px;font-weight:500;color:var(--text-2);white-space:nowrap;transition:background var(--t-fast),color var(--t-fast)}
.ds-seg button:hover{color:var(--text-strong)}
.ds-seg button[aria-pressed="true"]{background:var(--text-strong);color:var(--bg)}
.ds-seg--xs button{height:26px;padding:0 10px;font-size:12px}

.ds-wrap{max-width:1240px;margin:0 auto;padding-left:40px;padding-right:40px}

/* Обложка */
.ds-hero{position:relative;padding-block:72px 64px;display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:40px;align-items:end;overflow:hidden}
.ds-hero__meta{display:flex;flex-wrap:wrap;gap:10px 28px;margin-top:28px}
.ds-hero__meta span{display:flex;flex-direction:column;gap:4px}
.ds-hero__meta b{font-size:15px;font-weight:500;color:var(--text-strong)}
.ds-hero__sign{justify-self:end;width:min(300px,100%);color:var(--text-strong)}
.ds-hero__sign svg{width:100%;height:auto}
.ds-hero__lead{margin-top:28px;max-width:52ch}

.ds-princ{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:8px}
.ds-princ>div{background:var(--surface);border-radius:var(--r-20);padding:24px;display:flex;flex-direction:column;gap:12px;min-height:188px}
.ds-princ>div .dd-label{margin-bottom:20px}
.ds-princ b{font-size:19px;font-weight:500;letter-spacing:-.01em;color:var(--text-strong);line-height:1.25}
.ds-princ p{font-size:14px;color:var(--text-2);line-height:1.45}

/* Раздел */
.ds-sec{padding-block:112px 24px;border-top:1px solid var(--line)}
.ds-sec__head{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:20px 40px;align-items:start;margin-bottom:24px}
.ds-sec__eyebrow{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;margin-bottom:20px}
.ds-sec__eyebrow .tag{font-family:var(--font-tech);font-size:12px;letter-spacing:.05em;color:var(--accent-text)}
.ds-sec__lead{color:var(--text-2);max-width:54ch}
.ds-status-line{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;margin-top:4px}
.ds-status-line span{display:inline-flex;align-items:center;gap:8px}

.ds-block{margin-top:64px}
.ds-block:first-of-type{margin-top:40px}
.ds-bh{display:flex;flex-direction:column;gap:10px;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--line-soft)}
.ds-bh .dd-h4{max-width:40ch}
.ds-cols{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:24px 40px;align-items:start}
.ds-cols--even{grid-template-columns:repeat(2,minmax(0,1fr))}
.ds-cols--3{grid-template-columns:repeat(3,minmax(0,1fr))}
.ds-prose{display:flex;flex-direction:column;gap:12px;max-width:62ch}
.ds-prose p{color:var(--text)}
.ds-prose p.dd-small{color:var(--text-2)}
.ds-plus{display:flex;flex-direction:column;gap:10px}
.ds-plus li{position:relative;padding-left:22px;color:var(--text);line-height:1.45}
.ds-plus li::before{content:"+";position:absolute;left:0;top:0;color:var(--accent-text);font-weight:500}
.ds-plus li b{color:var(--text-strong);font-weight:500}

/* Сцена с живым примером */
.ds-stage{position:relative;border-radius:var(--r-20);border:1px solid var(--line-soft);overflow:hidden;min-width:0}
.ds-stage__bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 12px 10px 20px;border-bottom:1px solid var(--line-soft)}
.ds-stage__body{padding:32px}
.ds-stage__body--flush{padding:0}
.ds-stage__body--tight{padding:20px}
.ds-stage+.ds-stage{margin-top:8px}

/* Таблица значений */
.ds-spec{overflow-x:auto;border-radius:var(--r-20);background:var(--surface);-webkit-overflow-scrolling:touch}
.ds-spec table{width:100%;min-width:620px;font-size:14px}
.ds-spec th,.ds-spec td{text-align:left;padding:14px 18px;border-bottom:1px solid var(--line-soft);vertical-align:middle}
.ds-spec th{font-family:var(--font-tech);font-size:11px;font-weight:400;letter-spacing:.05em;text-transform:uppercase;color:var(--text-2);border-bottom-color:var(--line)}
.ds-spec td{color:var(--text)}
.ds-spec td:first-child{color:var(--text-strong);font-weight:500}
.ds-spec tr:last-child td{border-bottom:0}
.ds-spec td .dd-small{display:block;margin-top:2px}
.ds-spec code{color:var(--text-2)}
.ds-spec--wide table{min-width:880px}

/* Копирование значений */
.cp{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:var(--r-pill);background:var(--surface-2);color:var(--text-strong);font-family:var(--font-tech);font-size:12px;letter-spacing:.04em;white-space:nowrap;transition:background var(--t-fast),color var(--t-fast);font-variant-numeric:tabular-nums;vertical-align:middle}
.cp:hover{background:var(--surface-3);color:var(--accent-text)}
.cp::after{content:"";width:12px;height:12px;flex:none;opacity:.55;background:currentColor;-webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='8' y='8' width='12' height='12' rx='2'/><path d='M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2'/></svg>") center/contain no-repeat;mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='8' y='8' width='12' height='12' rx='2'/><path d='M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2'/></svg>") center/contain no-repeat}
.cp--plain{background:transparent;padding:0;height:auto}
.cp--plain:hover{background:transparent}
.cps{display:flex;flex-wrap:wrap;gap:6px}

/* Можно / нельзя */
.ds-dd{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.ds-dd+.ds-dd{margin-top:8px}
.ds-do{display:flex;flex-direction:column;border-radius:var(--r-20);background:var(--surface);overflow:hidden;min-width:0}
.ds-do__vis{position:relative;min-height:200px;padding:24px;display:flex;align-items:center;justify-content:center;overflow:hidden}
.ds-do__vis--start{justify-content:flex-start}
.ds-do figcaption{display:flex;flex-direction:column;gap:8px;padding:18px 22px 22px;border-top:1px solid var(--line-soft)}
.ds-do figcaption p{font-size:14px;line-height:1.45;color:var(--text-2)}
.ds-do figcaption p b{color:var(--text-strong);font-weight:500}
.ds-badge{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-tech);font-size:12px;letter-spacing:.05em;text-transform:uppercase}
.ds-badge svg{width:14px;height:14px}
.ds-badge--do{color:var(--ok)}
.ds-badge--dont{color:var(--err)}

/* Пометки для команды */
.ds-note{display:none;margin-top:16px;padding:12px 16px;border:1px dashed var(--line);border-radius:var(--r-12);font-size:13px;line-height:1.5;color:var(--text-2);max-width:78ch}
.ds-note::before{content:"Для команды · ";font-family:var(--font-tech);font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--accent-text)}
.show-notes .ds-note{display:block}
.ds-note--inline{display:none}
.show-notes .ds-note--inline{display:inline-flex}

/* Свитч оболочки */
.ds-switch{display:inline-flex;align-items:center;gap:10px;font-size:13px;font-weight:500;color:var(--text-2);cursor:pointer;min-height:32px}
.ds-switch input{position:absolute;opacity:0;width:1px;height:1px}
.ds-switch i{position:relative;width:34px;height:20px;border-radius:var(--r-pill);background:var(--surface-3);border:1px solid var(--line);transition:background var(--t-fast),border-color var(--t-fast)}
.ds-switch i::after{content:"";position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:var(--text-2);transition:transform var(--t-fast),background var(--t-fast)}
.ds-switch input:checked+i{background:var(--accent-fill);border-color:var(--accent-fill)}
.ds-switch input:checked+i::after{transform:translateX(14px);background:var(--on-accent)}
.ds-switch input:focus-visible+i{outline:2px solid var(--focus);outline-offset:2px}

/* Код */
.ds-code{position:relative;border-radius:var(--r-20);background:var(--surface);overflow:hidden}
.ds-code pre{margin:0;padding:24px;max-height:520px;overflow:auto;font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;font-size:12.5px;line-height:1.6;color:var(--text);white-space:pre}
.ds-code__bar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px 12px 24px;border-bottom:1px solid var(--line-soft)}

/* Уведомление о копировании */
.ds-toast{position:fixed;left:50%;bottom:24px;z-index:120;transform:translate(-50%,12px);padding:12px 18px;border-radius:var(--r-pill);background:var(--c-white);color:var(--c-dark);font-size:14px;font-weight:500;box-shadow:0 16px 40px rgba(0,0,0,.45);opacity:0;visibility:hidden;transition:opacity var(--t-fast),transform var(--t-fast),visibility var(--t-fast);max-width:calc(100% - 32px);text-align:center;pointer-events:none}
.ds-toast.is-on{opacity:1;visibility:visible;transform:translate(-50%,0)}
.ds-toast b{font-family:var(--font-tech);font-weight:400;letter-spacing:.04em}

.ds-foot{padding-block:64px 80px;border-top:1px solid var(--line);margin-top:96px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px 40px;color:var(--text-2);font-size:13px}

/* Сводные таблицы-статусы */
.ds-check{display:flex;flex-direction:column;gap:8px}
.ds-check li{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:14px;align-items:start;padding:18px 22px;border-radius:var(--r-20);background:var(--surface)}
.ds-check li svg{width:20px;height:20px;margin-top:2px}
.ds-check li b{display:block;font-weight:500;color:var(--text-strong)}
.ds-check li p{font-size:14px;color:var(--text-2);margin-top:4px;line-height:1.45}
.ds-check .ok{color:var(--ok)}
.ds-check .part{color:var(--warn)}
.ds-check .todo{color:var(--text-3)}

/* Мобильная навигация */
.ds-scrim{display:none}
@media (max-width:1100px){
  .ds{grid-template-columns:1fr}
  .ds-side{position:fixed;inset:0 auto 0 0;z-index:90;width:min(320px,86vw);transform:translateX(-102%);transition:transform var(--t-slow);box-shadow:var(--shadow-pop)}
  .ds-side.is-open{transform:none}
  .ds-scrim{position:fixed;inset:0;z-index:80;background:rgba(9,10,12,.55);backdrop-filter:blur(6px);display:block;opacity:0;visibility:hidden;transition:opacity var(--t-fast),visibility var(--t-fast)}
  .ds-scrim.is-open{opacity:1;visibility:visible}
  .ds-menu-btn{display:inline-flex}
}
@media (max-width:900px){
  .ds-top{padding:10px 20px}
  .ds-wrap{padding-left:20px;padding-right:20px}
  .ds-hero{grid-template-columns:1fr;padding-block:48px 40px}
  .ds-hero__sign{justify-self:start;width:160px;order:-1}
  .ds-princ{grid-template-columns:1fr 1fr}
  .ds-sec{padding-block:80px 16px}
  .ds-sec__head{grid-template-columns:1fr}
  .ds-cols,.ds-cols--even,.ds-cols--3{grid-template-columns:1fr}
  .ds-stage__body{padding:20px}
}
@media (max-width:640px){
  .ds-princ{grid-template-columns:1fr}
  .ds-princ>div{min-height:0}
  .ds-dd{grid-template-columns:1fr}
  .ds-top__title b{display:none}
  .ds-top__ctrl{gap:8px}
  .ds-block{margin-top:48px}
}


/* ==========================================================================
   Компоненты бренда (префикс dd-)
   ========================================================================== */
.logo{color:var(--logo)}
.ic{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.ic--20{width:20px;height:20px}.ic--24{width:24px;height:24px}.ic--32{width:32px;height:32px;stroke-width:2}

/* ---------- Кнопки ---------- */
.dd-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:10px;height:var(--btn-m);padding:0 22px;border-radius:var(--r-pill);border:1px solid transparent;font-family:var(--font-sans);font-size:15px;font-weight:500;line-height:1;letter-spacing:0;white-space:nowrap;text-decoration:none;cursor:pointer;user-select:none;transition:background var(--t-fast),color var(--t-fast),border-color var(--t-fast),transform var(--t-fast),box-shadow var(--t-fast)}
.dd-btn .ic{transition:transform var(--t-fast)}
.dd-btn--l{height:var(--btn-l);padding:0 28px;font-size:16px}
.dd-btn--s{height:var(--btn-s);padding:0 16px;font-size:14px;gap:8px}
.dd-btn--primary{background:var(--btn-bg);color:var(--btn-fg)}
.dd-btn--primary:hover,.dd-btn--primary.is-hover{background:var(--btn-hover-bg);color:var(--btn-hover-fg)}
.dd-btn--primary:active,.dd-btn--primary.is-press{background:var(--btn-press-bg);color:var(--btn-fg);transform:translateY(1px)}
.dd-btn--secondary{background:transparent;color:var(--text-strong);border-color:var(--line)}
.dd-btn--secondary:hover,.dd-btn--secondary.is-hover{border-color:var(--accent-line);background:var(--accent-tint)}
.dd-btn--secondary:active,.dd-btn--secondary.is-press{background:var(--surface-3);border-color:var(--accent-line);transform:translateY(1px)}
.dd-btn--glass{background:rgba(9,10,12,.35);color:#fff;border-color:rgba(255,255,255,.28);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.dd-btn--glass:hover,.dd-btn--glass.is-hover{border-color:var(--brand-signal);background:rgba(9,10,12,.55)}
.dd-btn--text{height:auto;min-height:var(--touch);padding:0;border:0;background:none;color:var(--text-strong);border-radius:var(--r-4)}
.dd-btn--text>span{position:relative;padding-bottom:4px;border-bottom:1px solid var(--line)}
.dd-btn--text>span::after{content:"";position:absolute;left:0;bottom:-1px;height:1px;width:0;background:var(--accent-line);transition:width .35s cubic-bezier(.2,.6,.2,1)}
.dd-btn--text:hover>span::after,.dd-btn--text.is-hover>span::after{width:100%}
.dd-btn--text:active,.dd-btn--text.is-press{color:var(--text-2)}
.dd-btn--icon{width:var(--btn-m);padding:0;border-color:var(--line);background:transparent;color:var(--text-strong)}
.dd-btn--icon.dd-btn--s{width:var(--btn-s)}
.dd-btn--icon:hover,.dd-btn--icon.is-hover{background:var(--accent-fill);color:var(--on-accent);border-color:var(--accent-fill)}
.dd-btn:hover .ic--ur,.dd-btn.is-hover .ic--ur{transform:translate(2px,-2px)}
.dd-btn:hover .ic--r,.dd-btn.is-hover .ic--r{transform:translateX(3px)}
.dd-btn:hover .ic--d,.dd-btn.is-hover .ic--d{transform:translateY(3px)}
.dd-btn:focus-visible,.dd-btn.is-focus{outline:2px solid var(--focus);outline-offset:3px;border-radius:var(--r-pill)}
.dd-btn--text:focus-visible,.dd-btn--text.is-focus{border-radius:var(--r-4)}
.dd-btn[disabled],.dd-btn.is-disabled{background:var(--surface-3);color:var(--text-3);border-color:transparent;cursor:not-allowed;transform:none;box-shadow:none}
.dd-btn--secondary[disabled],.dd-btn--secondary.is-disabled,.dd-btn--icon.is-disabled{background:transparent;border-color:var(--line-soft)}
.dd-btn--text[disabled],.dd-btn--text.is-disabled{background:none}
.dd-btn--text.is-disabled>span{border-bottom-color:var(--line-soft)}
.dd-btn.is-loading{pointer-events:none}
.dd-btn.is-loading .ic{display:none}
.dd-spin{width:16px;height:16px;border-radius:50%;border:1.5px solid currentColor;border-right-color:transparent;animation:ddspin .8s linear infinite;flex:none}
@keyframes ddspin{to{transform:rotate(360deg)}}
.dd-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.dd-link{color:var(--text-strong);text-decoration:underline;text-decoration-color:var(--line);text-decoration-thickness:1px;text-underline-offset:3px;transition:text-decoration-color var(--t-fast)}
.dd-link:hover{text-decoration-color:var(--accent-line)}
@media (max-width:639px){.dd-btn--s{height:var(--btn-m);padding:0 20px;font-size:15px}.dd-btn--icon.dd-btn--s{width:var(--btn-m)}}

/* ---------- Формы ---------- */
.dd-form{display:grid;gap:20px}
.dd-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.dd-field{display:flex;flex-direction:column;gap:8px;min-width:0}
.dd-field__label{display:flex;justify-content:space-between;align-items:baseline;gap:8px;font-family:var(--font-tech);font-size:12px;line-height:1.3;letter-spacing:.05em;text-transform:uppercase;color:var(--text-2)}
.dd-field__label em{font-style:normal;text-transform:none;letter-spacing:0;font-family:var(--font-sans);font-size:12px;color:var(--text-2)}
.dd-input,.dd-select,.dd-textarea{width:100%;height:var(--field-h);padding:0 18px;border-radius:var(--r-12);background:var(--surface-field);border:1px solid var(--line);color:var(--text-strong);font:400 16px/1.4 var(--font-sans);appearance:none;-webkit-appearance:none;transition:border-color var(--t-fast),box-shadow var(--t-fast),background var(--t-fast)}
.dd-input::placeholder,.dd-textarea::placeholder{color:var(--text-2);opacity:1}
.dd-input:hover,.dd-select:hover,.dd-textarea:hover,.dd-input.is-hover{border-color:var(--line-strong)}
.dd-input:focus,.dd-select:focus,.dd-textarea:focus,.dd-input.is-focus{outline:none;border-color:var(--accent-line);box-shadow:0 0 0 3px var(--accent-tint)}
.dd-textarea{height:auto;min-height:132px;padding:14px 18px;line-height:1.5;resize:vertical}
.dd-selectwrap{position:relative}
.dd-select{padding-right:48px;cursor:pointer}
.dd-selectwrap .ic{position:absolute;right:18px;top:50%;transform:translateY(-50%);pointer-events:none;color:var(--text-2)}
.dd-select option{background:var(--surface-pop);color:var(--text-strong)}
.dd-field.is-error .dd-input,.dd-field.is-error .dd-textarea,.dd-field.is-error .dd-select{border-color:var(--err)}
.dd-field.is-error .dd-input:focus{box-shadow:0 0 0 3px color-mix(in srgb,var(--err) 22%,transparent)}
.dd-input:disabled,.dd-select:disabled,.dd-textarea:disabled{background:var(--surface-2);color:var(--text-3);border-color:transparent;cursor:not-allowed}
.dd-field.is-disabled .dd-field__label{color:var(--text-3)}
.dd-field__hint{font-size:13px;line-height:1.4;color:var(--text-2)}
.dd-field__err{display:flex;gap:8px;align-items:flex-start;font-size:13px;line-height:1.4;color:var(--err)}
.dd-field__err .ic{margin-top:1px}
.dd-field__foot{display:flex;justify-content:space-between;gap:12px}
.dd-count{font-family:var(--font-tech);font-size:12px;letter-spacing:.05em;color:var(--text-2);font-variant-numeric:tabular-nums}

.dd-check{display:flex;gap:12px;align-items:flex-start;padding-block:12px;font-size:14px;line-height:1.5;color:var(--text);cursor:pointer}
.dd-check input{appearance:none;-webkit-appearance:none;position:relative;flex:none;width:20px;height:20px;margin:1px 0 0;border:1px solid var(--line-strong);border-radius:var(--r-4);background:var(--surface-field);cursor:pointer;transition:background var(--t-fast),border-color var(--t-fast)}
.dd-check input:hover{border-color:var(--text-2)}
.dd-check input:checked{background:var(--accent-fill);border-color:var(--accent-fill)}
.dd-check input[type="checkbox"]:checked::after{content:"";position:absolute;left:6px;top:2px;width:5px;height:10px;border:solid var(--on-accent);border-width:0 1.5px 1.5px 0;transform:rotate(45deg)}
.dd-check input[type="radio"]{border-radius:50%}
.dd-check input[type="radio"]:checked{background:var(--surface-field);border-color:var(--accent-fill)}
.dd-check input[type="radio"]:checked::after{content:"";position:absolute;left:4px;top:4px;width:10px;height:10px;border-radius:50%;background:var(--accent-fill)}
.dd-check input:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.dd-check input:disabled{background:var(--surface-2);border-color:var(--line-soft);cursor:not-allowed}
.dd-check.is-disabled{color:var(--text-3);cursor:not-allowed}
.dd-check.is-error input{border-color:var(--err)}
.dd-check a{color:var(--text-strong);text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:3px}
.dd-radios{display:flex;flex-wrap:wrap;gap:0 24px}
.dd-fieldset{border:0;margin:0;padding:0;min-width:0;display:flex;flex-direction:column;gap:4px}
.dd-fieldset legend{padding:0;margin-bottom:4px}

.dd-switch{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:var(--touch);font-size:15px;color:var(--text);cursor:pointer}
.dd-switch input{appearance:none;-webkit-appearance:none;position:relative;flex:none;width:44px;height:26px;margin:0;border-radius:var(--r-pill);background:var(--surface-3);border:1px solid var(--line-strong);cursor:pointer;transition:background var(--t-fast),border-color var(--t-fast)}
.dd-switch input::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--text-2);transition:transform var(--t-fast),background var(--t-fast)}
.dd-switch input:checked{background:var(--accent-fill);border-color:var(--accent-fill)}
.dd-switch input:checked::after{transform:translateX(18px);background:var(--on-accent)}
.dd-switch input:focus-visible{outline:2px solid var(--focus);outline-offset:2px}

.dd-seg{display:inline-flex;padding:4px;border-radius:var(--r-pill);background:var(--surface-2);gap:2px;max-width:100%;overflow-x:auto;scrollbar-width:none}
