.rl .btnt{fill:var(--btn-fg);font-family:var(--font-sans);font-weight:500}
.rl .btni{fill:none;stroke:var(--btn-fg);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.rl .t{fill:var(--text-strong);font-family:var(--font-sans)}
.rl .t2{fill:var(--text-2);font-family:var(--font-sans)}
.rl .tl{fill:var(--text-2);font-family:var(--font-tech);letter-spacing:.05em}
.rl .th{fill:var(--text-strong);font-family:var(--font-sans);font-weight:var(--w-h1);letter-spacing:-.05em}
.rl .d{stroke:var(--accent-line);stroke-width:1;fill:none}
.rl .d2{stroke:var(--accent-line);stroke-width:2;fill:none;stroke-linecap:round}
.rl .g{stroke:var(--accent-line);stroke-width:1;stroke-dasharray:4 4;opacity:.7;fill:none}
.rl .col{fill:color-mix(in srgb,var(--accent) 9%,transparent)}
.rl .ln{stroke:var(--line);stroke-width:1}
.rl .acc{fill:var(--accent-line)}
.rl .dt{fill:var(--accent-text);font-family:var(--font-tech);font-size:11px;letter-spacing:.04em}
.rl .ct{fill:var(--text);font-family:var(--font-sans);font-size:13px}
.rl .ct b,.rl .ctb{font-weight:600;fill:var(--text-strong)}

/* ---------- Роли в работе (подписи к строкам) ---------- */
.tu{display:flex;flex-direction:column}
.tu__row{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:20px;align-items:center;padding:14px 0;border-bottom:1px dashed var(--line-soft)}
