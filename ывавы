    if(c){c.setAttribute("aria-pressed",String(c.getAttribute("aria-pressed")!=="true"));return}
    var t=e.target.closest("[role=tab]");
    if(t){var list=t.closest("[role=tablist]");$$("[role=tab]",list).forEach(function(x){var on=x===t;x.setAttribute("aria-selected",String(on));x.tabIndex=on?0:-1;var p=document.getElementById(x.getAttribute("aria-controls"));if(p)p.hidden=!on})}
  });

  /* ---------- Демо: счетчик символов ---------- */
  $$("[data-count-for]").forEach(function(c){
    var f=document.getElementById(c.getAttribute("data-count-for"));if(!f)return;
    var max=f.getAttribute("maxlength")||"";
    function upd(){c.textContent=f.value.length+(max?" / "+max:"")}
    f.addEventListener("input",upd);upd();
  });

  /* ---------- Демо: проверка формы ---------- */
  var form=$("#demo-form");
  if(form){
    var mail=$("#f-mail"),mailE=$("#f-mail-e"),agree=$("#f-agree"),agreeE=$("#f-agree-e"),ok=$("#f-ok"),sub=$("#f-submit");
    function mailOk(){return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(mail.value.trim())}
    function showMail(){var bad=!mailOk();mail.closest(".dd-field").classList.toggle("is-error",bad);mail.setAttribute("aria-invalid",String(bad));mailE.hidden=!bad;if(bad)mail.setAttribute("aria-describedby","f-mail-e");else mail.removeAttribute("aria-describedby")}
    mail.addEventListener("blur",function(){if(mail.value)showMail()});
    mail.addEventListener("input",function(){if(!mailE.hidden&&mailOk())showMail()});
    agree.addEventListener("change",function(){if(agree.checked){agreeE.hidden=true;$("#f-agree-w").classList.remove("is-error")}});
    form.addEventListener("submit",function(e){
      e.preventDefault();ok.hidden=true;
      showMail();
      var ag=agree.checked;agreeE.hidden=ag;$("#f-agree-w").classList.toggle("is-error",!ag);
      if(!mailOk()){mail.focus();return}
      if(!ag){agree.focus();return}
      sub.classList.add("is-loading");sub.innerHTML='<span class="dd-spin"></span>Отправляем';
      setTimeout(function(){sub.classList.remove("is-loading");sub.textContent="Подать заявку";ok.hidden=false},1200);
    });
  }

  /* ---------- Демо: загрузка кнопки ---------- */
  $$("[data-demo-loading]").forEach(function(b){
    var html=b.innerHTML;
    b.addEventListener("click",function(){
      if(b.classList.contains("is-loading"))return;
      b.classList.add("is-loading");b.setAttribute("aria-busy","true");b.innerHTML='<span class="dd-spin"></span>Отправляем';
      setTimeout(function(){b.classList.remove("is-loading");b.removeAttribute("aria-busy");b.innerHTML=html},2000);
    });
  });

  /* ---------- Демо: модальное окно ---------- */
  var lastFocus=null;
  function openModal(id){
    var tpl=document.getElementById(id);if(!tpl)return;
    lastFocus=document.activeElement;
    var ov=document.createElement("div");ov.className="dd-overlay";ov.setAttribute("data-surface",(tpl.getAttribute("data-surface")||"dark"));
    ov.innerHTML=tpl.innerHTML;document.body.appendChild(ov);
    var m=$(".dd-modal",ov);m.setAttribute("role","dialog");m.setAttribute("aria-modal","true");
    var f=$("[data-autofocus]",ov)||$("button",ov);if(f)f.focus();
    function close(){ov.remove();document.removeEventListener("keydown",onKey);if(lastFocus)lastFocus.focus()}
    function onKey(e){if(e.key==="Escape")close();if(e.key==="Tab"){var fs=$$("button,a,input,select,textarea",ov);if(!fs.length)return;var first=fs[0],last=fs[fs.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}}
    ov.addEventListener("click",function(e){if(e.target===ov||e.target.closest("[data-close]"))close()});
    document.addEventListener("keydown",onKey);
  }
  document.addEventListener("click",function(e){var b=e.target.closest("[data-open-modal]");if(b)openModal(b.getAttribute("data-open-modal"))});
  document.addEventListener("click",function(e){var b=e.target.closest("[data-demo-toast]");if(b)say(b.getAttribute("data-demo-toast"))});

  /* ---------- Демо: длина текста ---------- */
  $$("[data-len-switch]").forEach(function(g){
    var box=document.getElementById(g.getAttribute("data-len-switch"));
    $$("button",g).forEach(function(b){b.addEventListener("click",function(){box.setAttribute("data-mode",b.getAttribute("data-len"));$$("button",g).forEach(function(x){x.setAttribute("aria-pressed",String(x===b))})})});
  });

  /* ---------- Демо: переключатели классов (сетка слайда, безопасные зоны) ---------- */
  $$("[data-toggle-class]").forEach(function(inp){
    var tgt=document.getElementById(inp.getAttribute("data-target"));
    function upd(){if(tgt)tgt.classList.toggle(inp.getAttribute("data-toggle-class"),inp.checked)}
    inp.addEventListener("change",upd);upd();
  });

  /* ---------- Демо: сетка Tilda по брейкпоинтам ---------- */
  var gx=$("#gx-frame"),gxl=$("#gx-label"),gxw=$("#gx-wrap"),gxW=1200;
  function gxFit(){if(!gx||!gxw)return;var z=Math.min(1,gxw.clientWidth/gxW);gx.style.zoom=String(z)}
  $$("[data-bp]").forEach(function(b){
    b.addEventListener("click",function(){
      var d=b.getAttribute("data-bp").split(",");gxW=+d[0];
      gx.style.width=d[0]+"px";gx.style.setProperty("--cols",d[1]);gx.style.setProperty("--gut",d[2]+"px");gx.style.setProperty("--pad",d[3]+"px");
      var cols=gx.querySelector(".gx__cols");cols.innerHTML=new Array(+d[1]+1).join("<i></i>");
      gxl.textContent=d[0]+" px · "+d[1]+" колонок · промежуток "+d[2]+" px · поля "+d[3]+" px"+(d[4]?" · колонка "+d[4]+" px":"");
      $$("[data-bp]").forEach(function(x){x.setAttribute("aria-pressed",String(x===b))});
      gxFit();
    });
  });
  window.addEventListener("resize",gxFit);
  var firstBp=$("[data-bp][aria-pressed=true]");if(firstBp)firstBp.click();

  /* ---------- Чек-лист макета ---------- */
  var chk=$("#chk");
  if(chk){
    var boxes=$$("input[type=checkbox]",chk),cnt=$("[data-chk-count]",chk),bar=$("[data-chk-bar]",chk),done=$("[data-chk-done]",chk);
    function chkUpd(){var n=boxes.filter(function(b){return b.checked}).length;cnt.textContent=n;bar.style.width=(n/boxes.length*100)+"%";chk.classList.toggle("is-done",n===boxes.length);if(done)done.hidden=n!==boxes.length}
    boxes.forEach(function(b){b.addEventListener("change",chkUpd)});
    var rs=$("[data-chk-reset]",chk);if(rs)rs.addEventListener("click",function(){boxes.forEach(function(b){b.checked=false});chkUpd()});
    chkUpd();
  }

  /* ---------- Слайды на весь экран: плавное открытие и разметка ---------- */
  (function(){
    var all=$$(".sl");if(!all.length)return;
    var G='<svg class="slx-g" viewBox="0 0 1920 1080" preserveAspectRatio="none" aria-hidden="true"><rect class="gf" x="0" y="0" width="192" height="1080"/><rect class="gf" x="1728" y="0" width="192" height="1080"/><rect class="gf2" x="192" y="0" width="1536" height="160"/><rect class="gf2" x="192" y="944" width="1536" height="136"/><rect class="gf3" x="192" y="160" width="1536" height="72"/><rect class="gc" x="192" y="232" width="106" height="712"/><rect class="gc" x="322" y="232" width="106" height="712"/><rect class="gc" x="452" y="232" width="106" height="712"/><rect class="gc" x="582" y="232" width="106" height="712"/><rect class="gc" x="712" y="232" width="106" height="712"/><rect class="gc" x="842" y="232" width="106" height="712"/><rect class="gc" x="972" y="232" width="106" height="712"/><rect class="gc" x="1102" y="232" width="106" height="712"/><rect class="gc" x="1232" y="232" width="106" height="712"/><rect class="gc" x="1362" y="232" width="106" height="712"/><rect class="gc" x="1492" y="232" width="106" height="712"/><rect class="gc" x="1622" y="232" width="106" height="712"/><path class="gd" d="M192 232V944M298 232V944"/><path class="gd" d="M322 232V944M428 232V944"/><path class="gd" d="M452 232V944M558 232V944"/><path class="gd" d="M582 232V944M688 232V944"/><path class="gd" d="M712 232V944M818 232V944"/><path class="gd" d="M842 232V944M948 232V944"/><path class="gd" d="M972 232V944M1078 232V944"/><path class="gd" d="M1102 232V944M1208 232V944"/><path class="gd" d="M1232 232V944M1338 232V944"/><path class="gd" d="M1362 232V944M1468 232V944"/><path class="gd" d="M1492 232V944M1598 232V944"/><path class="gd" d="M1622 232V944M1728 232V944"/><path class="gl" d="M192 0V1080M1728 0V1080M0 160H1920M0 232H1920M0 944H1920"/><g class="gp"><rect x="61" y="526" width="70" height="32" rx="16"/><text x="96" y="548" text-anchor="middle">192</text></g><g class="gp"><rect x="1789" y="526" width="70" height="32" rx="16"/><text x="1824" y="548" text-anchor="middle">192</text></g><g class="gp"><rect x="865" y="68" width="190" height="32" rx="16"/><text x="960" y="90" text-anchor="middle">шапка 160</text></g><g class="gp"><rect x="925" y="184" width="70" height="32" rx="16"/><text x="960" y="206" text-anchor="middle">72</text></g><g class="gp"><rect x="875" y="998" width="170" height="32" rx="16"/><text x="960" y="1020" text-anchor="middle">поле 136</text></g><g class="gp"><rect x="207" y="184" width="76" height="32" rx="16"/><text x="245" y="206" text-anchor="middle">106</text></g><g class="gp"><rect x="290" y="184" width="60" height="32" rx="16"/><text x="320" y="206" text-anchor="middle">24</text></g><g class="gp"><rect x="1460" y="184" width="200" height="32" rx="16"/><text x="1560" y="206" text-anchor="middle">12 колонок</text></g><g class="gp"><rect x="61" y="358" width="70" height="32" rx="16"/><text x="96" y="380" text-anchor="middle">712</text></g></svg>';
    function ic(n){return '<svg class="ic ic--20" aria-hidden="true"><use href="#i-'+n+'"/></svg>'}
    var box=document.createElement("div");box.className="slx";box.hidden=true;box.setAttribute("data-surface","dark");
    box.setAttribute("role","dialog");box.setAttribute("aria-modal","true");box.setAttribute("aria-label","Слайд на весь экран");
    box.innerHTML='<div class="slx__bg" data-slx="close"></div>'+
      '<div class="slx__bar"><span class="dd-label slx__count"></span>'+
      '<label class="ds-switch slx__sw" for="slx-g"><input type="checkbox" id="slx-g"><i></i>Разметка: поля, колонки, силовые линии</label>'+
      '<div class="slx__nav"><button type="button" class="slx__btn" data-slx="prev" aria-label="Предыдущий слайд">'+ic("arrow-l")+'</button>'+
      '<button type="button" class="slx__btn" data-slx="next" aria-label="Следующий слайд">'+ic("arrow-r")+'</button>'+
      '<button type="button" class="slx__btn" data-slx="close" aria-label="Закрыть">'+ic("close")+'</button></div></div>'+
      '<div class="slx__stage"><div class="slx__frame"></div></div>'+
      '<p class="dd-label slx__hint">← → листать · G разметка · Esc закрыть</p>';
    document.body.appendChild(box);
    var frame=$(".slx__frame",box),count=$(".slx__count",box),gsw=$("#slx-g",box),closeBtn=$(".slx__btn[data-slx=close]",box);
    var list=[],idx=0,busy=false,reduce=window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    all.forEach(function(s){s.setAttribute("tabindex","0");s.setAttribute("role","button");s.setAttribute("aria-label","Открыть слайд на весь экран")});
    function show(i,fade){
      idx=(i+list.length)%list.length;
      var c=list[idx].cloneNode(true);c.removeAttribute("tabindex");c.removeAttribute("role");c.removeAttribute("aria-label");
      c.insertAdjacentHTML("beforeend",G);
      if(fade&&!reduce){frame.classList.add("is-swap");setTimeout(function(){frame.innerHTML="";frame.appendChild(c);frame.classList.remove("is-swap")},140)}
      else{frame.innerHTML="";frame.appendChild(c)}
      count.textContent="Слайд "+(idx+1)+" из "+list.length;
    }
    function visible(el){var r=el.getBoundingClientRect();return r.width>0&&r.bottom>0&&r.top<innerHeight}
    function fromTo(el){var a=el.getBoundingClientRect(),b=frame.getBoundingClientRect();return "translate("+(a.left-b.left)+"px,"+(a.top-b.top)+"px) scale("+(a.width/b.width)+")"}
    function open(el){
      if(busy)return;busy=true;
      var blk=el.closest(".ds-block")||el.parentNode;
      list=$$(".sl",blk).filter(function(x){return !x.closest(".slx")});
      show(list.indexOf(el));
      box.hidden=false;document.documentElement.classList.add("slx-open");
      frame.style.transition="none";frame.style.transformOrigin="0 0";
      if(!reduce)frame.style.transform=fromTo(el);
      frame.offsetWidth;
      frame.style.transition="";frame.style.transform="";
      box.classList.add("is-on");
      setTimeout(function(){busy=false},450);
      closeBtn.focus({preventScroll:true});
      document.addEventListener("keydown",onKey);
    }
    function close(){
      if(busy)return;busy=true;
      var el=list[idx];
      if(el&&visible(el)&&!reduce){frame.style.transform=fromTo(el)}
      box.classList.remove("is-on");
      document.removeEventListener("keydown",onKey);
      setTimeout(function(){box.hidden=true;frame.style.transition="none";frame.style.transform="";frame.innerHTML="";document.documentElement.classList.remove("slx-open");busy=false;if(el)el.focus({preventScroll:true})},reduce?0:420);
    }
    function guides(on){gsw.checked=on;box.classList.toggle("show-guides",on)}
    function onKey(e){
      if(e.key==="Escape"){e.preventDefault();close()}
      else if(e.key==="ArrowRight"){show(idx+1,true)}
      else if(e.key==="ArrowLeft"){show(idx-1,true)}
      else if((e.key==="g"||e.key==="G"||e.key==="п"||e.key==="П")&&e.target!==gsw){guides(!gsw.checked)}
      else if(e.key==="Tab"){var f=$$("button,input",box);var first=f[0],lastF=f[f.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();lastF.focus()}else if(!e.shiftKey&&document.activeElement===lastF){e.preventDefault();first.focus()}}
    }
    gsw.addEventListener("change",function(){guides(gsw.checked)});
    box.addEventListener("click",function(e){var b=e.target.closest("[data-slx]");if(!b)return;var a=b.getAttribute("data-slx");if(a==="close")close();else if(a==="prev")show(idx-1,true);else if(a==="next")show(idx+1,true)});
    document.addEventListener("click",function(e){var s=e.target.closest(".sl");if(!s||s.closest(".slx"))return;open(s)});
    document.addEventListener("keydown",function(e){var t=e.target;if((e.key==="Enter"||e.key===" ")&&t.classList&&t.classList.contains("sl")&&!t.closest(".slx")){e.preventDefault();open(t)}});
  })();
})();

</script>
