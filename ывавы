        <tr><td>980–1200 · планшет горизонтальный</td><td><button type="button" class="cp" data-copy="960px" title="Скопировать">960</button> внутри 980</td><td>12</td><td>60</td><td><button type="button" class="cp" data-copy="20px" title="Скопировать">20</button></td><td><button type="button" class="cp" data-copy="10px" title="Скопировать">10</button></td><td>72</td></tr>
        <tr><td>640–980 · планшет вертикальный</td><td><button type="button" class="cp" data-copy="640px" title="Скопировать">640</button></td><td>4</td><td><button type="button" class="cp" data-copy="135px" title="Скопировать">135</button></td><td>20</td><td>20</td><td>64</td></tr>
