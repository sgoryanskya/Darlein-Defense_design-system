              <div class="dd-selectwrap"><select class="dd-select" id="f-dir" name="dir"><option>Программные решения</option><option>Коммуникационные решения</option><option>Беспилотные решения</option><option>Робототехнические решения</option><option>Инфраструктурные решения</option></select><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-chev-d"/></svg></div>
            </div>
