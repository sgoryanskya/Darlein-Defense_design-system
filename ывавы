            <fieldset class="dd-fieldset"><legend class="dd-field__label">Как связаться</legend>
              <div class="dd-radios">
                <label class="dd-check" for="f-c1"><input type="radio" name="contact" id="f-c1" checked>Почта</label>
                <label class="dd-check" for="f-c2"><input type="radio" name="contact" id="f-c2">Телефон</label>
