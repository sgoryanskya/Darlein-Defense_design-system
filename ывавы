/* ---------- Маршруты по ролям ---------- */
.starts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.start{display:flex;flex-direction:column;gap:10px;padding:22px;border-radius:var(--r-20);background:var(--surface);min-width:0}
.start b{font-size:17px;font-weight:500;letter-spacing:-.01em;line-height:1.3;color:var(--text-strong)}
.start .chiplinks{margin-top:auto;padding-top:8px}
.chiplinks{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.chiplinks a{display:inline-flex;align-items:center;height:32px;padding:0 12px;border-radius:var(--r-pill);background:var(--surface-2);font-size:13px;font-weight:500;color:var(--text-strong);white-space:nowrap;transition:background var(--t-fast),color var(--t-fast)}
