.msc{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.msc figure{display:flex;flex-direction:column;gap:10px;min-width:0}
.msc__f{position:relative;height:240px;border-radius:var(--r-20);overflow:hidden;border:1px solid var(--line-soft);padding:16px 20px;display:flex;flex-direction:column;gap:12px}
